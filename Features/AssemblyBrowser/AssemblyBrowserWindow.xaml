<Window x:Class="VinTed.Features.AssemblyBrowser.AssemblyBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Light"
        Title="VinTed — Assembly Browser"
        Width="900" Height="650"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        FontFamily="Segoe UI">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf Theme (Light) -->
                <ui:ThemeResources RequestedTheme="Light"/>
                <ui:XamlControlsResources/>
                <!-- VinTed Shared Theme -->
                <ResourceDictionary Source="/VinTed;component/Themes/ThemeColors.xaml"/>
                <ResourceDictionary Source="/VinTed;component/Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource VtBgPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" Background="{StaticResource VtAccentPrimary}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Icon -->
                <Path Grid.Column="0" 
                      Data="M3 3h8v8H3zm10 0h8v8h-8zM3 13h8v8H3zm10 0h8v8h-8z"
                      Fill="White" 
                      Stretch="Uniform" 
                      Width="24" 
                      Height="24" 
                      Margin="0,0,12,0"
                      VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ASSEMBLY BROWSER" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="White"/>
                    <TextBlock x:Name="txtDocumentName" 
                               Text="No document loaded" 
                               FontSize="11.5" 
                               Foreground="#E8F4FF" 
                               Margin="0,3,0,0"
                               Opacity="0.9"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content: DataGrid Card -->
        <Border Grid.Row="1" 
                Margin="16,12,16,12"
                Background="{StaticResource VtBgCard}"
                BorderBrush="{StaticResource VtBorderLight}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" 
                        BorderBrush="{StaticResource VtBorderLight}"
                        BorderThickness="0,0,0,1" 
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="COMPONENT LIST" 
                                   FontSize="11"
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource VtFgSecondary}"/>
                        
                        <Button Grid.Column="1" 
                                x:Name="btnRefresh"
                                Click="BtnRefresh_Click"
                                Style="{StaticResource VtBtnSecondary}"
                                Height="28"
                                Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M17.65 6.35A7.96 7.96 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4z"
                                      Fill="{StaticResource VtFgSecondary}" 
                                      Stretch="Uniform" 
                                      Width="13" 
                                      Height="13" 
                                      Margin="0,0,6,0" 
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="Refresh" 
                                           VerticalAlignment="Center"
                                           FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="dgComponents"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="36"
                          FontSize="12.5"
                          SelectionChanged="DgComponents_SelectionChanged">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource VtFgSecondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource VtBorderLight}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="COMPONENT NAME" 
                                            Binding="{Binding Name}" 
                                            Width="*" 
                                            MinWidth="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0,8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="MATERIAL" 
                                            Binding="{Binding Material}" 
                                            Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource VtFgSecondary}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="QTY" 
                                            Binding="{Binding Quantity}" 
                                            Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="MASS (KG)" 
                                            Binding="{Binding Mass}" 
                                            Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="FULL PATH" 
                                            Binding="{Binding FullPath}" 
                                            Width="280">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="8,0,12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource VtFgTertiary}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8F4FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource VtAccentPrimary}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource VtStatusBar}">
            <Grid>
                <TextBlock x:Name="txtStatus" 
                           Text="Ready  ·  Ctrl+Click: Multi-select  ·  Shift+Click: Range select"
                           Style="{StaticResource VtStatusText}"/>
                
                <Button Content="Close" 
                        HorizontalAlignment="Right"
                        Click="BtnClose_Click"
                        Style="{StaticResource VtBtnSecondary}"
                        Height="26"
                        Padding="16,0"
                        FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
