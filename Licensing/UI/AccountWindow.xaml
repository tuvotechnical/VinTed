<Window x:Class="VinTed.Licensing.UI.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Light"
        Title="VinTed — Tài khoản"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf Theme (Light) -->
                <ui:ThemeResources RequestedTheme="Light"/>
                <ui:XamlControlsResources/>
                <!-- VinTed Shared Theme -->
                <ResourceDictionary Source="/VinTed;component/Themes/ThemeColors.xaml"/>
                <ResourceDictionary Source="/VinTed;component/Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F5F6F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="0,0,16,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#005DA6" Offset="0"/>
                    <GradientStop Color="#0078D4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="👤  Tài Khoản VinTed"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="28,20,28,20">

            <!-- Account Info Card -->
            <Border Background="White" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                      Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Thông tin tài khoản" FontSize="15"
                               FontWeight="SemiBold" Foreground="#1A1A1A"
                               Margin="0,0,0,14"/>

                    <!-- Email -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email:" Grid.Column="0"
                                   FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtEmail" Grid.Column="1"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A1A1A" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Thiết bị -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thiết bị:" Grid.Column="0"
                                   FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtDevice" Grid.Column="1"
                                   FontSize="13" Foreground="#1A1A1A"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- License Info Card -->
            <Border Background="White" CornerRadius="12" Padding="20"
                    Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                      Color="#000000" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="License" FontSize="15"
                               FontWeight="SemiBold" Foreground="#1A1A1A"
                               Margin="0,0,0,14"/>

                    <!-- Trạng thái -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Trạng thái:" Grid.Column="0"
                                   FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtStatus" Grid.Column="1"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Gói -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gói:" Grid.Column="0"
                                   FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtPlan" Grid.Column="1"
                                   FontSize="13" Foreground="#1A1A1A"/>
                    </Grid>

                    <!-- Hết hạn -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hết hạn:" Grid.Column="0"
                                   FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtExpires" Grid.Column="1"
                                   FontSize="13" Foreground="#1A1A1A"/>
                    </Grid>

                    <!-- Còn lại -->
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Còn lại:" Grid.Column="0"
                                   FontSize="13" Foreground="#666"/>
                        <TextBlock x:Name="txtDaysLeft" Grid.Column="1"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#005DA6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBuyLicense" Grid.Column="0"
                        Content="Mua / Gia hạn"
                        Height="38" FontSize="13" FontWeight="SemiBold"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        Click="BtnBuyLicense_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#005DA6"/>
                            <Setter Property="BorderBrush" Value="#005DA6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#004B87"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnLogout" Grid.Column="2"
                        Content="Đăng xuất"
                        Height="38" FontSize="13"
                        HorizontalAlignment="Stretch"
                        Click="BtnLogout_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
