<Window x:Class="VinTed.Licensing.UI.BuyLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Light"
        Title="VinTed — Mua License"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf Theme (Light) -->
                <ui:ThemeResources RequestedTheme="Light"/>
                <ui:XamlControlsResources/>
                <!-- VinTed Shared Theme -->
                <ResourceDictionary Source="/VinTed;component/Themes/ThemeColors.xaml"/>
                <ResourceDictionary Source="/VinTed;component/Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F5F6F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="0,0,16,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#005DA6" Offset="0"/>
                    <GradientStop Color="#0078D4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🛒  Mua License VinTed"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Margin="24,16,24,16">
            <StackPanel>
                <!-- Plan Selection -->
                <Border x:Name="panelPlanSelection" Background="White"
                        CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                          Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Chọn gói license" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#1A1A1A"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Daily -->
                            <Border x:Name="cardDaily" Grid.Column="0"
                                    CornerRadius="10" Margin="0,0,6,0"
                                    BorderThickness="2" BorderBrush="#E0E0E0"
                                    Background="White" Cursor="Hand"
                                    MouseLeftButtonUp="CardDaily_Click"
                                    Padding="8,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1 Ngày" FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="#333"/>
                                    <TextBlock Text="20.000đ" FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#005DA6"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="1 thiết bị" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="#999"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Monthly -->
                            <Border x:Name="cardMonthly" Grid.Column="1"
                                    CornerRadius="10" Margin="3,0,3,0"
                                    BorderThickness="2" BorderBrush="#005DA6"
                                    Background="#F0F7FF" Cursor="Hand"
                                    MouseLeftButtonUp="CardMonthly_Click"
                                    Padding="8,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#005DA6" CornerRadius="4"
                                            Padding="6,2" HorizontalAlignment="Center"
                                            Margin="0,0,0,4">
                                        <TextBlock Text="Phổ biến" FontSize="10"
                                                   Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="1 Tháng" FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="#333"/>
                                    <TextBlock Text="199.000đ" FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#005DA6"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="2 thiết bị" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="#999"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Yearly -->
                            <Border x:Name="cardYearly" Grid.Column="2"
                                    CornerRadius="10" Margin="6,0,0,0"
                                    BorderThickness="2" BorderBrush="#E0E0E0"
                                    Background="White" Cursor="Hand"
                                    MouseLeftButtonUp="CardYearly_Click"
                                    Padding="8,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="1 Năm" FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="#333"/>
                                    <TextBlock Text="1.990K" FontSize="16"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#005DA6"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="2 thiết bị" FontSize="11"
                                               HorizontalAlignment="Center"
                                               Foreground="#999"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- QR Code + Payment Info (ẩn cho đến khi chọn gói) -->
                <Border x:Name="panelPayment" Background="White"
                        CornerRadius="12" Padding="20" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2"
                                          Color="#000000" Opacity="0.06"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Quét mã QR để thanh toán"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1A1A1A"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,14"/>

                        <!-- QR Image -->
                        <Border Background="#FAFAFA" CornerRadius="8"
                                Padding="8" HorizontalAlignment="Center">
                            <Image x:Name="imgQrCode"
                                   Width="220" Height="220"
                                   Stretch="Uniform"/>
                        </Border>

                        <!-- Payment details -->
                        <StackPanel Margin="0,14,0,0">
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nội dung CK:" Grid.Column="0"
                                           FontSize="13" Foreground="#666"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtOrderCode" Grid.Column="1"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#D32F2F"
                                           TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Số tiền:" Grid.Column="0"
                                           FontSize="13" Foreground="#666"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtAmount" Grid.Column="1"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#1A1A1A"/>
                            </Grid>
                        </StackPanel>

                        <!-- Status -->
                        <Border Background="#FFF8E1" CornerRadius="6"
                                Padding="12,8" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="⏳" FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtStatus"
                                           Text="Đang chờ thanh toán..."
                                           FontSize="13" Foreground="#F57F17"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtCountdown"
                                           Text="" FontSize="13"
                                           Foreground="#F57F17"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Success panel (ẩn) -->
                        <Border x:Name="panelSuccess" Background="#E8F5E9"
                                CornerRadius="6" Padding="12,8"
                                Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="✅ Thanh toán thành công! License đã được kích hoạt."
                                       FontSize="13" Foreground="#2E7D32"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Error panel (ẩn) -->
                        <TextBlock x:Name="txtPaymentError"
                                   Foreground="#D32F2F" FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"/>

                        <!-- Cancel button -->
                        <Button x:Name="btnCancel" Content="Hủy"
                                HorizontalAlignment="Center"
                                Width="120" Height="34"
                                Margin="0,14,0,0"
                                Click="BtnCancel_Click"/>
                    </StackPanel>
                </Border>

                <!-- Loading -->
                <ui:ProgressRing x:Name="progressRing"
                                 Width="36" Height="36"
                                 IsActive="False"
                                 Visibility="Collapsed"
                                 HorizontalAlignment="Center"
                                 Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
