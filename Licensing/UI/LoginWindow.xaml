<Window x:Class="VinTed.Licensing.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:ThemeManager.RequestedTheme="Light"
        Title="VinTed — Đăng nhập"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ModernWpf Theme (Light) -->
                <ui:ThemeResources RequestedTheme="Light"/>
                <ui:XamlControlsResources/>
                <!-- VinTed Shared Theme -->
                <ResourceDictionary Source="/VinTed;component/Themes/ThemeColors.xaml"/>
                <ResourceDictionary Source="/VinTed;component/Themes/ControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F5F6F7">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header gradient -->
        <Border Grid.Row="0" CornerRadius="0,0,16,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#005DA6" Offset="0"/>
                    <GradientStop Color="#0078D4" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔐  VinTed Account"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Margin="32,24,32,24"
                Background="White" CornerRadius="12"
                Padding="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2"
                                  Color="#000000" Opacity="0.08"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <!-- Title -->
                <TextBlock x:Name="txtTitle" Text="Đăng nhập"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#1A1A1A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Email -->
                <TextBlock Text="Email" FontSize="13" Foreground="#666"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="txtEmail"
                         ui:ControlHelper.PlaceholderText="example@email.com"
                         FontSize="14" Padding="10,8"
                         Margin="0,0,0,14"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" FontSize="13" Foreground="#666"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword"
                             FontSize="14" Padding="10,8"
                             Margin="0,0,0,6"
                             KeyDown="TxtPassword_KeyDown"/>

                <!-- Confirm Password (chỉ hiện khi đăng ký) -->
                <TextBlock x:Name="lblConfirmPassword" Text="Xác nhận mật khẩu"
                           FontSize="13" Foreground="#666"
                           Margin="0,0,0,6" Visibility="Collapsed"/>
                <PasswordBox x:Name="txtConfirmPassword"
                             FontSize="14" Padding="10,8"
                             Margin="0,0,0,6" Visibility="Collapsed"/>

                <!-- Error message -->
                <TextBlock x:Name="txtError"
                           Foreground="#D32F2F" FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,12"
                           Visibility="Collapsed"/>

                <!-- Login / SignUp button -->
                <Button x:Name="btnSubmit" Content="ĐĂNG NHẬP"
                        HorizontalAlignment="Stretch"
                        Height="40" FontSize="14" FontWeight="SemiBold"
                        Foreground="White"
                        Margin="0,8,0,12"
                        Click="BtnSubmit_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#005DA6"/>
                            <Setter Property="BorderBrush" Value="#005DA6"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border"
                                                        Property="Background" Value="#004B87"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border"
                                                        Property="Background" Value="#B0B0B0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Toggle Sign In / Sign Up -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                    <TextBlock x:Name="txtToggleLabel" Text="Chưa có tài khoản?"
                               FontSize="13" Foreground="#666"
                               VerticalAlignment="Center"/>
                    <Button x:Name="btnToggle" Content="Đăng ký"
                            FontSize="13" Foreground="#005DA6"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Padding="4,0"
                            Click="BtnToggle_Click"/>
                </StackPanel>

                <!-- Loading indicator -->
                <ui:ProgressRing x:Name="progressRing"
                                 Width="32" Height="32"
                                 Margin="0,12,0,0"
                                 IsActive="False"
                                 Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
